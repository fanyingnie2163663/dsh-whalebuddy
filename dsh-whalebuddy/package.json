{
  "name": "dsh-whalebuddy",
  "version": "0.1.0",
  "private": true,
  "description": "Whalebuddy：给 DeepSeek Harness 带来有档案、有默契、能延续的同事。",
  "license": "MIT",
  "author": "聂凡瑛 <fanyingnie@gmail.com>",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "colleague",
    "memory"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "kind": "plugin",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "capabilities": [
      "fs:read",
      "fs:write",
      "network:ingress",
      "sessions:read",
      "system-prompt:write"
    ],
    "labels": []
  },
  "dependencies": {
    "schemastery": "^3.18.0",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "oxlint lib test",
    "check": "npm run typecheck && npm run lint && node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3"
  }
}
